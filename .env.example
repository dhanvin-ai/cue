# Local development only. Use Secret Manager for deployed credentials.
MIGRATION_DATABASE_URL=postgresql://cue_admin:cue_local_admin@localhost:5433/cue
DATABASE_URL=postgresql://cue_app:cue_local_app@localhost:5433/cue
CUE_APP_DB_PASSWORD=cue_local_app
CUE_INGEST_DB_PASSWORD=cue_local_ingest
INGEST_DATABASE_URL=postgresql://cue_ingest:cue_local_ingest@localhost:5433/cue
FIREBASE_PROJECT_ID=your-firebase-project-id
RAW_EVENTS_TOPIC=projects/your-project/topics/cue-raw-events
RAW_EVENTS_SUBSCRIPTION=projects/your-project/subscriptions/cue-raw-events-ingest
CANONICAL_EVENTS_TOPIC=projects/your-project/topics/cue-canonical-events
CANONICAL_EVENTS_SUBSCRIPTION=projects/your-project/subscriptions/cue-memory-worker
RAW_GCS_BUCKET=your-cue-raw-bucket
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY_SECRET_VERSION=projects/your-project/secrets/qdrant-key/versions/latest
# OpenAI-compatible inference service hosting Qwen/Qwen3-Embedding-0.6B at 1024 dimensions.
EMBEDDING_BASE_URL=http://localhost:8001
# EMBEDDING_API_KEY_SECRET_VERSION=projects/your-project/secrets/qwen-key/versions/latest
# Straitly (OpenAI-compatible). Cue appends /v1/chat/completions, so omit /v1 here.
MODEL_GATEWAY_BASE_URL=https://api.straitly.ai
MEMORY_SMALL_MODEL=google/gemini-2.5-flash
# MODEL_GATEWAY_API_KEY=  # local dev only; paste your Straitly key
# MODEL_GATEWAY_API_KEY_SECRET_VERSION=projects/your-project/secrets/model-gateway-key/versions/latest
SYNC_TRIGGERS_TOPIC=projects/your-project/topics/cue-sync-triggers
SYNC_TRIGGERS_SUBSCRIPTION=projects/your-project/subscriptions/cue-sync-triggers-worker
GMAIL_PUSH_TOPIC=projects/your-project/topics/cue-gmail-push
GMAIL_PUSH_SUBSCRIPTION=projects/your-project/subscriptions/cue-gmail-push-worker
CALENDAR_WEBHOOK_URL=https://your-api.example/webhooks/calendar
CALENDAR_CHANNEL_SECRET_VERSION=projects/your-project/secrets/calendar-channel-key/versions/latest
SLACK_SIGNING_SECRET_VERSION=projects/your-project/secrets/slack-signing-secret/versions/latest
LINEAR_WEBHOOK_SECRET_VERSION=projects/your-project/secrets/linear-webhook-secret/versions/latest
RECALL_VERIFICATION_SECRET_VERSION=projects/your-project/secrets/recall-verification-secret/versions/latest
RECALL_REGION=us-east-1
GITHUB_APP_ID=your-github-app-id
GITHUB_PRIVATE_KEY_SECRET_VERSION=projects/your-project/secrets/github-app-private-key/versions/latest
GITHUB_WEBHOOK_SECRET_VERSION=projects/your-project/secrets/github-webhook-secret/versions/latest
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-collector.example/v1/traces

# Agent runtime (Phase 6)
AGENT_PRIMARY_MODEL=gemini-2.5-pro
AGENT_FALLBACK_MODEL=claude-sonnet-4.5
EMAIL_INGRESS_SECRET_VERSION=projects/your-project/secrets/email-ingress/versions/latest
INTERNAL_TASK_TOKEN_SECRET_VERSION=projects/your-project/secrets/internal-task-token/versions/latest
GOOGLE_CLOUD_PROJECT=your-project
CLOUD_TASKS_LOCATION=asia-south1
CLOUD_TASKS_QUEUE=cue-agent-tasks
CLOUD_TASKS_TARGET_URL=https://your-api.example
CLOUD_TASKS_SERVICE_ACCOUNT=cue-tasks@your-project.iam.gserviceaccount.com

# Meeting voice (Phase 7)
RECALL_API_KEY_SECRET_VERSION=projects/your-project/secrets/recall-api-key/versions/latest
RECALL_REGION=us-east-1
STT_ENDPOINT=https://stt.insurge.internal
TTS_ENDPOINT=https://tts.insurge.internal

# Bolna meeting voice (docs/bolna.md)
# BOLNA_API_KEY=  # operator only, used by scripts/bolna_setup.py
# BOLNA_LLM_KEYS=TENANT_UUID=KEY_PRINTED_BY_SETUP
# BOLNA_PHONE_NUMBER=+91XXXXXXXXXX

# Dev-only auth bypass + console wiring (cue/main.py). When CUE_DEV_AUTH_UID is
# set, every authenticated endpoint trusts that uid without a Firebase token.
# Never set these outside local development; /ui returns 404 without them.
# CUE_DEV_AUTH_UID=dev-local-user
# CUE_DEV_TENANT_ID=11111111-1111-1111-1111-111111111111

# Local stack (docs/local-connectors.md): emulators instead of GCP, files instead of Secret Manager.
# PUBSUB_EMULATOR_HOST=localhost:8085
# STORAGE_EMULATOR_HOST=http://localhost:4443
# RAW_EVENTS_TOPIC=projects/cue-local/topics/cue-raw-events
# RAW_EVENTS_SUBSCRIPTION=projects/cue-local/subscriptions/cue-raw-events-ingest
# CANONICAL_EVENTS_TOPIC=projects/cue-local/topics/cue-canonical-events
# CANONICAL_EVENTS_SUBSCRIPTION=projects/cue-local/subscriptions/cue-memory-worker
# SYNC_TRIGGERS_TOPIC=projects/cue-local/topics/cue-sync-triggers
# SYNC_TRIGGERS_SUBSCRIPTION=projects/cue-local/subscriptions/cue-sync-triggers-worker
# RAW_GCS_BUCKET=cue-local-raw
# GITHUB_PRIVATE_KEY_SECRET_VERSION=file:github-app.pem/versions/latest
# GITHUB_WEBHOOK_SECRET_VERSION=file:github-webhook.txt/versions/latest
# CUE_AGENT_EMAIL=cue@yourdomain.com   # the agent's own Gmail/Calendar seat
# CUE_DEFAULT_REPO=your-org/demo-repo
